# ===== Contoh konfigurasi Docker =====
# Salin file ini menjadi .env lalu isi nilainya:
#   cp env.docker.example .env
# (Windows PowerShell: Copy-Item env.docker.example .env)

# Port di host tempat aplikasi diakses -> http://localhost:8080
APP_PORT=8080

# Nama database
DB_NAME=itsm_kpi_db

# ---- SECRETS (WAJIB DIGANTI UNTUK PRODUKSI) ----
# Generate nilai acak yang kuat, mis:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string
WEBHOOK_CRON_SECRET=change-me-too

# Akun admin pertama yang dibuat saat pertama kali boot
ADMIN_EMAIL=admin@itsm.local
ADMIN_PASSWORD=change-me-strong-password

# ---- Cookie / auth behavior ----
# HTTP biasa (mis. http://localhost:8080): biarkan false + lax
# Di belakang HTTPS (reverse proxy TLS): set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS: dengan Nginx bawaan (same-origin) biarkan *
CORS_ORIGINS=*

# Seed data demo saat pertama boot.
# false = database bersih (hanya akun admin dibuat).
# true  = 8 akun demo + 15 tiket contoh (password akun demo: password123).
SEED_DEMO=false
